---
import BaseLayout from '~/layouts/BaseLayout.astro';
import '~/styles/view-transitions.css';
import { LOCALES, ROUTES, type Locale } from '~/i18n/config';
import { bookPath, sectionPath } from '~/i18n/paths';
import { useTranslations, interpolate } from '~/i18n/ui';
import {
  ALL_BOOKS,
  coverFor,
  paletteFor,
  dimensionsFor,
  neighbours,
  synopsisFor,
  type BookRecord,
} from '~/data/books';
import { bookNode } from '~/lib/seo/schema';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    ALL_BOOKS.map((book) => ({
      params: { lang, section: ROUTES[lang].works, book: book.id },
      props: { book },
    })),
  );
}

const locale = Astro.params.lang as Locale;
const { book } = Astro.props as { book: BookRecord };
const t = useTranslations(locale);

const palette = paletteFor(book.id);
const catalogueNumber = String(ALL_BOOKS.findIndex((entry) => entry.id === book.id) + 1).padStart(
  2,
  '0',
);
const cover = dimensionsFor(book.id);
const { previous, next } = neighbours(book.id);
const synopsis = synopsisFor(book, locale);

const description = interpolate(t.book.metaDescription, {
  title: book.title,
  author: book.author,
  publisher: book.publisher,
});
const coverAlt = interpolate(t.book.coverAlt, { title: book.title, author: book.author });

const rows: Array<{ label: string; value: string }> = [
  { label: t.book.originalTitle, value: book.originalTitle },
  { label: t.book.author, value: book.author },
  { label: t.book.publisher, value: book.publisher },
  { label: t.book.year, value: String(book.year) },
  { label: t.book.from, value: t.languages[book.originalLanguage] },
  { label: t.book.into, value: t.languages[book.targetLanguage] },
  { label: t.book.category, value: t.categories[book.category] },
  ...(book.pageCount ? [{ label: t.book.pages, value: String(book.pageCount) }] : []),
  { label: t.book.isbn, value: book.isbn },
  ...(book.coTranslators?.length
    ? [{ label: t.book.coTranslators, value: book.coTranslators.join(' · ') }]
    : []),
];

const bookSchema = bookNode(book, locale, Astro.site ?? new URL(Astro.url.origin));

const titleVtClass = '[view-transition-class:vt-title]';
---

<BaseLayout
  locale={locale}
  title={book.title}
  description={description}
  page={{ kind: 'book', slug: book.id }}
  current="works"
  ogType="book"
  ogImage={{ src: coverFor(book.id), width: cover.width, height: cover.height, alt: coverAlt }}
  mainEntity={bookSchema}
  about={{ '@id': bookSchema['@id'] as string }}
  tint={{ color: palette.spineColor, contrast: palette.textColor }}
>
  <Fragment slot="head">
    {/* This page's LCP. */}
    <link rel="preload" as="image" href={coverFor(book.id)} fetchpriority="high" />
    <meta property="book:isbn" content={book.isbn} />
    <meta property="book:release_date" content={String(book.year)} />
  </Fragment>

  <nav class="flex items-baseline justify-between gap-4 pt-[clamp(1.5rem,4vw,2.5rem)]">
    <a class="link-arrow group border-b-transparent text-ink-faint hover:text-ink" href={sectionPath(locale, 'works')}>
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
        class="group-hover:-translate-x-[0.2em]"
      >
        <path d="M19 12H6m5-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      {t.book.back}
    </a>
    <span class="font-sans text-[0.7rem] tracking-[0.14em] text-ink-faint tabular-nums" aria-hidden="true">
      {catalogueNumber} / {ALL_BOOKS.length}
    </span>
  </nav>

  <article
    class="grid items-start gap-[clamp(2rem,5vw,4rem)] py-[clamp(1.5rem,4vw,3rem)] min-[52rem]:grid-cols-[minmax(13rem,22rem)_minmax(0,1.5fr)]"
    data-reveal
  >
    <div
      class="relative rounded bg-paper-sunk bg-[radial-gradient(120%_90%_at_50%_100%,color-mix(in_srgb,var(--tint)_16%,transparent),transparent_70%)] p-[clamp(1.25rem,3vw,2.25rem)]"
    >
      {/* The names pair this cover and heading with the same volume's card in
          the catalogue, so the browser moves them across the navigation rather
          than fading the whole page. Per book, because the catalogue holds all
          22 at once and a view transition name has to be unique in a document. */}
      <img
        class="w-full rounded-[2px] shadow-[0_4px_10px_rgb(30_26_22/0.12),0_26px_60px_color-mix(in_srgb,var(--tint)_30%,transparent)] [view-transition-class:vt-cover]"
        src={coverFor(book.id)}
        width={cover.width}
        height={cover.height}
        alt={coverAlt}
        fetchpriority="high"
        style={`view-transition-name:cover-${book.id}`}
      />
    </div>

    <div>
      <p class="eyebrow">{book.publisher} · {book.year}</p>
      <h1 class={`mb-[0.15em] ${titleVtClass}`} style={`view-transition-name:title-${book.id}`}>
        {book.title}
      </h1>
      <p class="mb-[0.35em] text-[1.15rem] text-ink-soft">{book.author}</p>
      {/* Label-free on purpose: the `from`/`into` labels are nouns now, so an
          arrow reads better here than "Source language Deutsch". */}
      <p class="mb-8 font-sans text-[0.82rem] text-ink-faint">
        <i>{book.originalTitle}</i> · {t.languages[book.originalLanguage]} → {
          t.languages[book.targetLanguage]
        }
      </p>

      {
        synopsis && (
          <div>
            <h2 class="visually-hidden">{t.book.synopsis}</h2>
            <p class="text-[1.06em]">{synopsis}</p>
          </div>
        )
      }

      <h2 class="mt-10 border-t border-rule pt-5 font-sans text-[0.72rem] font-semibold tracking-[0.14em] text-ink-faint uppercase">
        {t.book.details}
      </h2>
      <dl class="book__details m-0 grid grid-cols-[repeat(auto-fit,minmax(min(100%,11rem),1fr))] gap-x-8 gap-y-4">
        {
          rows.map((row) => (
            <div>
              <dt class="font-sans text-[0.72rem] tracking-[0.12em] text-ink-faint uppercase">{row.label}</dt>
              <dd class="mt-[0.1rem] text-[0.95rem] tabular-nums">{row.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        book.sources.length > 0 && (
          <details class="mt-8 font-sans text-[0.78rem] text-ink-faint">
            <summary class="cursor-pointer">{t.book.sources} · {book.sources.length}</summary>
            <ul class="mt-[0.6rem] grid gap-[0.25rem] ps-[1.1rem]">
              {book.sources.map((href) => (
                <li>
                  <a href={href} rel="nofollow noopener" target="_blank">
                    {new URL(href).hostname.replace(/^www\./, '')}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </div>
  </article>

  <nav class="grid grid-cols-2 gap-4 border-t border-rule pt-8 pb-4" aria-label={t.works.title}>
    {
      previous ? (
        <a
          class="grid gap-[0.15rem] py-4 text-ink no-underline transition-colors duration-200 ease-brand hover:text-[var(--tint)]"
          href={bookPath(locale, previous.id)}
          rel="prev"
        >
          <span class="font-sans text-[0.7rem] tracking-[0.1em] text-ink-faint uppercase">
            ← {t.book.previous}
          </span>
          {/* Named after the volume it leads to, so walking the catalogue with
              the pager carries the title up into the next page's heading. */}
          <span class={`leading-[1.3] font-semibold ${titleVtClass}`} style={`view-transition-name:title-${previous.id}`}>
            {previous.title}
          </span>
        </a>
      ) : (
        // Holds the first grid column so a lone "next" link stays right-aligned.
        <span />
      )
    }
    {
      next && (
        <a
          class="grid gap-[0.15rem] py-4 text-end text-ink no-underline transition-colors duration-200 ease-brand hover:text-[var(--tint)]"
          href={bookPath(locale, next.id)}
          rel="next"
        >
          <span class="font-sans text-[0.7rem] tracking-[0.1em] text-ink-faint uppercase">
            {t.book.next} →
          </span>
          <span class={`leading-[1.3] font-semibold ${titleVtClass}`} style={`view-transition-name:title-${next.id}`}>
            {next.title}
          </span>
        </a>
      )
    }
  </nav>
</BaseLayout>
