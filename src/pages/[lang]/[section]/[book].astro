---
import BaseLayout from '~/layouts/BaseLayout.astro';
import '~/styles/view-transitions.css';
import { LOCALES, ROUTES, type Locale } from '~/i18n/config';
import { bookPath, sectionPath } from '~/i18n/paths';
import { useTranslations, interpolate } from '~/i18n/ui';
import {
  ALL_BOOKS,
  coverFor,
  paletteFor,
  dimensionsFor,
  neighbours,
  synopsisFor,
  type BookRecord,
} from '~/data/books';
import { bookNode } from '~/lib/seo/schema';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    ALL_BOOKS.map((book) => ({
      params: { lang, section: ROUTES[lang].works, book: book.id },
      props: { book },
    })),
  );
}

const locale = Astro.params.lang as Locale;
const { book } = Astro.props as { book: BookRecord };
const t = useTranslations(locale);

const palette = paletteFor(book.id);
const catalogueNumber = String(ALL_BOOKS.findIndex((entry) => entry.id === book.id) + 1).padStart(
  2,
  '0',
);
const cover = dimensionsFor(book.id);
const { previous, next } = neighbours(book.id);
const synopsis = synopsisFor(book, locale);

const description = interpolate(t.book.metaDescription, {
  title: book.title,
  author: book.author,
  publisher: book.publisher,
});
const coverAlt = interpolate(t.book.coverAlt, { title: book.title, author: book.author });

const rows: Array<{ label: string; value: string }> = [
  { label: t.book.originalTitle, value: book.originalTitle },
  { label: t.book.author, value: book.author },
  { label: t.book.publisher, value: book.publisher },
  { label: t.book.year, value: String(book.year) },
  { label: t.book.from, value: t.languages[book.originalLanguage] },
  { label: t.book.into, value: t.languages[book.targetLanguage] },
  { label: t.book.category, value: t.categories[book.category] },
  ...(book.pageCount ? [{ label: t.book.pages, value: String(book.pageCount) }] : []),
  { label: t.book.isbn, value: book.isbn },
  ...(book.coTranslators?.length
    ? [{ label: t.book.coTranslators, value: book.coTranslators.join(' · ') }]
    : []),
];

// The edition itself, as the thing this page *is* about. The layout hangs it off
// the page node and links its translator to the site's Person, so the credit is
// one statement rather than two coincidences.
const bookSchema = bookNode(book, locale, Astro.site ?? new URL(Astro.url.origin));
---

<BaseLayout
  locale={locale}
  title={book.title}
  description={description}
  page={{ kind: 'book', slug: book.id }}
  current="works"
  ogType="book"
  ogImage={{ src: coverFor(book.id), width: cover.width, height: cover.height, alt: coverAlt }}
  mainEntity={bookSchema}
  about={{ '@id': bookSchema['@id'] as string }}
  tint={{ color: palette.spineColor, contrast: palette.textColor }}
>
  <Fragment slot="head">
    {/* The cover is this page's largest element and its likely LCP, and it is
        discoverable in the markup rather than by script — so preloading it costs
        one line and moves it ahead of the stylesheet's own images. */}
    <link rel="preload" as="image" href={coverFor(book.id)} fetchpriority="high" />
    <meta property="book:isbn" content={book.isbn} />
    <meta property="book:release_date" content={String(book.year)} />
  </Fragment>

  <nav class="crumb">
    <a class="link-arrow crumb__link" href={sectionPath(locale, 'works')}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="crumb__arrow">
        <path d="M19 12H6m5-6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
      {t.book.back}
    </a>
    <span class="crumb__no" aria-hidden="true">{catalogueNumber} / {ALL_BOOKS.length}</span>
  </nav>

  <article class="book" data-reveal>
    <div class="book__cover">
      {/* The names pair this cover and heading with the same volume's card in
          the catalogue, so the browser moves them across the navigation rather
          than fading the whole page. Per book, because the catalogue holds all
          22 at once and a view transition name has to be unique in a document. */}
      <img
        src={coverFor(book.id)}
        width={cover.width}
        height={cover.height}
        alt={coverAlt}
        fetchpriority="high"
        style={`view-transition-name:cover-${book.id}`}
      />
    </div>

    <div class="book__body">
      <p class="eyebrow">{book.publisher} · {book.year}</p>
      <h1 style={`view-transition-name:title-${book.id}`}>{book.title}</h1>
      <p class="book__author">{book.author}</p>
      {/* Label-free on purpose: the `from`/`into` labels are nouns now, so an
          arrow reads better here than "Source language Deutsch". */}
      <p class="book__original">
        <i>{book.originalTitle}</i> · {t.languages[book.originalLanguage]} → {
          t.languages[book.targetLanguage]
        }
      </p>

      {
        synopsis && (
          <div class="book__synopsis">
            <h2 class="visually-hidden">{t.book.synopsis}</h2>
            <p>{synopsis}</p>
          </div>
        )
      }

      <h2 class="book__details-heading">{t.book.details}</h2>
      <dl class="book__details">
        {
          rows.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        book.sources.length > 0 && (
          <details class="book__sources">
            <summary>{t.book.sources} · {book.sources.length}</summary>
            <ul>
              {book.sources.map((href) => (
                <li>
                  <a href={href} rel="nofollow noopener" target="_blank">
                    {new URL(href).hostname.replace(/^www\./, '')}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </div>
  </article>

  <nav class="pager" aria-label={t.works.title}>
    {
      previous ? (
        <a class="pager__link" href={bookPath(locale, previous.id)} rel="prev">
          <span class="pager__label">← {t.book.previous}</span>
          {/* Named after the volume it leads to, so walking the catalogue with
              the pager carries the title up into the next page's heading. */}
          <span class="pager__title" style={`view-transition-name:title-${previous.id}`}>
            {previous.title}
          </span>
        </a>
      ) : (
        // Holds the first grid column so a lone "next" link stays right-aligned.
        <span></span>
      )
    }
    {
      next && (
        <a class="pager__link pager__link--next" href={bookPath(locale, next.id)} rel="next">
          <span class="pager__label">{t.book.next} →</span>
          <span class="pager__title" style={`view-transition-name:title-${next.id}`}>
            {next.title}
          </span>
        </a>
      )
    }
  </nav>
</BaseLayout>

<style>
  .crumb {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .crumb__link {
    color: var(--ink-faint);
    border-bottom-color: transparent;
  }

  .crumb__link:hover {
    color: var(--ink);
  }

  /* The arrow points back, so it should walk back on hover. */
  .crumb__link:hover .crumb__arrow {
    transform: translateX(-0.2em);
  }

  .crumb__no {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  .book {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }

  @media (min-width: 52rem) {
    .book {
      grid-template-columns: minmax(13rem, 22rem) minmax(0, 1.5fr);
    }
  }

  .book__cover {
    position: relative;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background:
      radial-gradient(
        120% 90% at 50% 100%,
        color-mix(in srgb, var(--tint) 16%, transparent),
        transparent 70%
      ),
      var(--paper-sunk);
    border-radius: var(--radius);
  }

  /* The transition *name* is per book, so it is set inline above; the *class* is
     what the rules in global.css hang off and is the same for every volume. */
  .book__body h1,
  .pager__title {
    view-transition-class: vt-title;
  }

  .book__cover img {
    view-transition-class: vt-cover;
    width: 100%;
    /* The intrinsic ratio comes from the width/height attributes above, which
       are the file's real dimensions — covers are not all 2:3. */
    height: auto;
    border-radius: 2px;
    box-shadow: 0 4px 10px rgb(30 26 22 / 0.12), 0 26px 60px
      color-mix(in srgb, var(--tint) 30%, transparent);
  }

  .book__body h1 {
    margin-bottom: 0.15em;
  }

  .book__author {
    font-size: 1.15rem;
    color: var(--ink-soft);
    margin-bottom: 0.35em;
  }

  .book__original {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin-bottom: 2rem;
  }

  .book__synopsis p {
    font-size: 1.06em;
  }

  .book__details-heading {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  .book__details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 1rem 2rem;
    margin: 0;
  }

  .book__details dt {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .book__details dd {
    margin: 0.1rem 0 0;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  .book__sources {
    margin-top: 2rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .book__sources summary {
    cursor: pointer;
  }

  .book__sources ul {
    margin: 0.6rem 0 0;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.25rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-block: 2rem 1rem;
    border-top: 1px solid var(--rule);
  }

  .pager__link {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    padding: 1rem 0;
    transition: color 200ms var(--ease);
  }

  .pager__link:hover {
    color: var(--tint);
  }

  .pager__link--next {
    text-align: end;
  }

  .pager__label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .pager__title {
    font-weight: 600;
    line-height: 1.3;
  }
</style>
