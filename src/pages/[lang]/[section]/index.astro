---
import BaseLayout from '~/layouts/BaseLayout.astro';
import '~/styles/view-transitions.css';
import WorksPage from '~/components/pages/WorksPage.astro';
import AboutPage from '~/components/pages/AboutPage.astro';
import ContactPage from '~/components/pages/ContactPage.astro';
import { LOCALES, ROUTES, SECTIONS, type Locale, type Section } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { translatePath } from '~/i18n/paths';
import { faqEntries } from '~/data/faq';
import {
  catalogueNode,
  personId,
  publicationNodes,
  questionNodes,
  type Node,
} from '~/lib/seo/schema';

/**
 * One thin router for the three top-level sections. Keeping them in a single
 * dynamic route avoids ambiguous sibling routes at this level while still
 * giving every language its own URL segment.
 */
export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    SECTIONS.map((section) => ({
      params: { lang, section: ROUTES[lang][section] },
      props: { section },
    })),
  );
}

const locale = Astro.params.lang as Locale;
const { section } = Astro.props as { section: Section };
const t = useTranslations(locale);

const meta: Record<Section, { title: string; description: string }> = {
  works: { title: t.works.title, description: t.works.metaDescription },
  about: { title: t.about.title, description: t.about.metaDescription },
  contact: { title: t.contact.title, description: t.contact.metaDescription },
};

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(translatePath(locale, { kind: 'section', section }), origin).href;

const faq = section === 'contact' ? faqEntries(locale) : [];

const mainEntity: Record<Section, Node | Node[] | undefined> = {
  works: catalogueNode(locale, origin, canonical),
  // A `ProfilePage` names whose profile it is; the node is already in the graph.
  about: { '@id': personId(origin) },
  contact: questionNodes(faq, canonical),
};

const extraNodes: Record<Section, Node[]> = {
  works: [],
  about: publicationNodes(locale, origin),
  contact: [],
};
---

<BaseLayout
  locale={locale}
  title={meta[section].title}
  description={meta[section].description}
  page={{ kind: 'section', section }}
  current={section}
  pageTypes={section === 'contact' ? ['FAQPage'] : []}
  mainEntity={mainEntity[section]}
  schema={extraNodes[section]}
>
  {section === 'works' && <WorksPage locale={locale} />}
  {section === 'about' && <AboutPage locale={locale} />}
  {section === 'contact' && <ContactPage locale={locale} />}
</BaseLayout>
