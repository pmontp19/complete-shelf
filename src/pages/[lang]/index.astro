---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Shelf from '~/components/Shelf.astro';
import { LOCALES, type Locale } from '~/i18n/config';
import { sectionPath } from '~/i18n/paths';
import { useTranslations } from '~/i18n/ui';
import { ALL_BOOKS, paletteFor } from '~/data/books';
import { collectionFacts } from '~/data/facts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const first = ALL_BOOKS[0];
const tint = first
  ? { color: paletteFor(first.id).spineColor, contrast: paletteFor(first.id).textColor }
  : undefined;

// The colophon band under the shelf: four facts about the collection, all
// derived from the bibliography so they can never drift out of date.
const collection = collectionFacts(locale);

const facts = [
  { label: t.works.title, value: String(collection.count) },
  { label: t.book.year, value: collection.count > 0 ? collection.span : '—' },
  {
    label: t.works.filterLanguage,
    value: collection.sourceLanguages.map((code) => t.languages[code]).join(' · '),
  },
  { label: t.book.publisher, value: collection.publishers.join(' · ') },
];
---

<BaseLayout
  locale={locale}
  title={t.site.name}
  description={t.home.metaDescription}
  page={{ kind: 'home' }}
  current="home"
  tint={tint}
  wide
>
  <section class="pt-[clamp(2rem,5vw,3.75rem)] pb-[clamp(1.5rem,3.5vw,2.75rem)]">
    <div class="shell">
      <p class="mb-[clamp(1rem,3vw,1.75rem)] max-w-[34ch] border-b border-rule pb-[clamp(1rem,3vw,1.75rem)] font-sans text-[length:var(--label-size)] font-semibold tracking-[var(--label-tracking)] text-ink-faint uppercase">
        {t.site.tagline}
      </p>
      <div class="grid items-end gap-[clamp(1rem,3vw,3rem)] lg:grid-cols-[minmax(0,1.35fr)_minmax(18rem,1fr)]">
        <h1 class="m-0 max-w-[14ch] text-[clamp(2.5rem,1.1rem+5.2vw,5.25rem)] leading-[0.98] font-semibold tracking-[-0.035em] text-balance">
          {t.site.name}
        </h1>
        <div class="pb-[0.35rem]">
          <p class="lead mb-[1.1rem] max-w-[38ch]">{t.home.heroLead}</p>
          <p class="m-0 flex max-w-[34ch] items-baseline gap-[0.65rem] font-sans text-[0.78rem] leading-[1.6] tracking-[0.02em] text-ink-faint">
            <span class="h-2 w-2 flex-none -translate-y-[0.1em] bg-[var(--tint)]" aria-hidden="true"></span>
            {t.home.shelfHint}
          </p>
        </div>
      </div>
    </div>
  </section>

  <Shelf locale={locale} />

  <section
    class="shell grid gap-[clamp(1.75rem,4vw,3rem)] py-[clamp(1.75rem,4vw,3rem)] pb-[clamp(3rem,7vw,5rem)] min-[62rem]:grid-cols-[minmax(0,1fr)_auto] min-[62rem]:items-end"
    data-reveal
  >
    <dl class="m-0 grid grid-cols-[repeat(auto-fit,minmax(min(100%,9rem),1fr))] gap-x-[clamp(1.5rem,4vw,3rem)] gap-y-6">
      {
        facts.map((fact) => (
          <div class="border-t border-rule pt-[0.85rem]">
            <dt class="mb-[0.35rem] font-sans text-[length:var(--label-size)] tracking-[var(--label-tracking)] text-ink-faint uppercase">
              {fact.label}
            </dt>
            <dd class="m-0 text-[1.05rem] leading-[1.35] tabular-nums">{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="flex flex-wrap gap-3">
      <a class="button" href={sectionPath(locale, 'works')}>
        {t.home.ctaWorks}
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="button__arrow">
          <path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
      <a class="button button--ghost" href={sectionPath(locale, 'about')}>{t.home.ctaAbout}</a>
    </div>
  </section>
</BaseLayout>
