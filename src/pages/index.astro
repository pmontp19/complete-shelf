---
/**
 * Root entry point. Every page lives under a locale segment, so the bare domain
 * is always a redirect.
 *
 * In production this file is never reached: Vercel answers `/` at the edge with
 * a 307 to the visitor's own language, or to /ca/ (see vercel.json). This is the
 * fallback for anything serving the built artifact without those rules — local
 * `astro preview`, or a static host — and it negotiates the same way, in the
 * client. It redirects immediately; the markup below is only ever seen if both
 * the meta refresh and JavaScript are unavailable, and then it is a usable list
 * of links rather than a dead end.
 *
 * `astro.config.mjs` has to keep `redirectToDefaultLocale: false` for any of
 * this to ship: with it on, Astro overwrites this page with a bare two-second
 * refresh of its own.
 */
import { LOCALES, LOCALE_NAMES, DEFAULT_LOCALE } from '~/i18n/config';
import { homePath } from '~/i18n/paths';

const defaultHref = homePath(DEFAULT_LOCALE);
const map = Object.fromEntries(LOCALES.map((code) => [code, homePath(code)]));

// Absolute, like every other canonical on the site: a relative one is legal but
// is resolved against whatever host served the page, mirrors included.
const canonical = new URL(defaultHref, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Judith Raigal Aran — Traductora literària</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${defaultHref}`} />
    <script is:inline define:vars={{ map, defaultHref }}>
      // Prefer the visitor's own language over the default locale.
      const preferred = (navigator.languages || [navigator.language || 'ca'])
        .map((tag) => String(tag).toLowerCase().split('-')[0])
        .find((code) => code in map);
      window.location.replace(preferred ? map[preferred] : defaultHref);
    </script>
    <style>
      /* Normally invisible — JS or the meta refresh moves on immediately. It
         still gets a dark variant so a JS-blocked visitor is not flashed. */
      :root {
        color-scheme: light dark;
      }
      body {
        font-family: Georgia, 'Times New Roman', serif;
        background: #f7f3ec;
        color: #1e1a16;
        display: grid;
        place-content: center;
        min-height: 100vh;
        margin: 0;
        text-align: center;
        gap: 1rem;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #16130f;
          color: #f2ece2;
        }
      }
      ul {
        display: flex;
        gap: 1rem;
        list-style: none;
        padding: 0;
        justify-content: center;
        flex-wrap: wrap;
      }
    </style>
  </head>
  <body>
    <h1>Judith Raigal Aran</h1>
    <nav>
      <ul>
        {LOCALES.map((code) => <li><a href={homePath(code)}>{LOCALE_NAMES[code]}</a></li>)}
      </ul>
    </nav>
  </body>
</html>
