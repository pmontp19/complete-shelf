---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { SECTIONS, type Locale, type Section } from '~/i18n/config';
import { homePath, sectionPath } from '~/i18n/paths';
import { useTranslations } from '~/i18n/ui';
import type { PageRef } from '~/i18n/page-ref';

interface Props {
  locale: Locale;
  page: PageRef;
  current: Section | 'home';
}

const { locale, page, current } = Astro.props;
const t = useTranslations(locale);

const links = SECTIONS.map((section) => ({
  section,
  href: sectionPath(locale, section),
  label: t.nav[section],
}));
---

<header
  class:list={[
    'header sticky top-0 z-20 border-b border-rule backdrop-blur-[10px] backdrop-saturate-[1.4]',
    'bg-[color-mix(in_srgb,var(--color-paper)_88%,transparent)]',
  ]}
>
  <div
    class="shell flex flex-wrap items-center gap-x-[clamp(1rem,3vw,2.5rem)] gap-y-[0.35rem] py-2 sm:flex-nowrap sm:gap-y-[clamp(1rem,3vw,2.5rem)] sm:py-3"
  >
    <a
      class="me-auto flex flex-col leading-[1.15] no-underline sm:leading-[1.2]"
      href={homePath(locale)}
      aria-current={current === 'home' ? 'page' : undefined}
    >
      <span class="text-[0.95rem] font-semibold tracking-[-0.01em] sm:text-[1.02rem]">{t.site.name}</span>
      <span class="font-sans text-[0.62rem] tracking-[0.13em] text-ink-faint uppercase sm:text-[0.72rem]">
        {t.site.role}
      </span>
    </a>

    <nav
      class="order-3 w-full border-t border-rule pt-[0.3rem] sm:order-none sm:w-auto sm:border-t-0 sm:pt-0"
      aria-label={t.a11y.mainNav}
    >
      <ul class="flex justify-between gap-[clamp(0.8rem,2vw,1.75rem)] sm:justify-start">
        {
          links.map((link) => (
            <li>
              <a
                class="border-b-[1.5px] border-transparent py-[0.25rem] font-sans text-[0.8rem] text-ink-soft no-underline transition-colors duration-[160ms] ease-brand hover:text-ink aria-[current=page]:border-accent aria-[current=page]:text-ink sm:py-[0.35rem] sm:text-[0.85rem]"
                href={link.href}
                aria-current={current === link.section ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <LanguageSwitcher locale={locale} page={page} />
  </div>
</header>
