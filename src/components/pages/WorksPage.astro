---
import { type Locale } from '~/i18n/config';
import { bookPath } from '~/i18n/paths';
import { useTranslations, interpolate } from '~/i18n/ui';
import { ALL_BOOKS, SOURCE_LANGUAGES, CATEGORIES, thumbFor, paletteFor } from '~/data/books';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const count = ALL_BOOKS.length;
const countLabel = count === 1 ? t.works.countOne : interpolate(t.works.count, { count });

const chipClass =
  'rounded-full border border-rule px-3 py-[0.3rem] font-sans text-[0.78rem] text-ink-soft transition-all duration-[160ms] ease-brand hover:border-ink-faint hover:text-ink [&.chip--on]:border-ink [&.chip--on]:bg-ink [&.chip--on]:text-paper [&.chip--on]:hover:border-[color-mix(in_srgb,var(--color-ink)_85%,var(--color-paper))] [&.chip--on]:hover:bg-[color-mix(in_srgb,var(--color-ink)_85%,var(--color-paper))]';
---

<div class="page-head">
  <p class="eyebrow">{countLabel}</p>
  <h1>{t.works.title}</h1>
  <p class="lead">{t.works.lead}</p>
</div>

{
  count > 0 && (
    <div class="mb-[clamp(1.75rem,4vw,3rem)] flex flex-wrap gap-[clamp(1rem,3vw,2.5rem)] border-y border-rule py-5" data-filters>
      <fieldset class="min-w-0">
        <legend class="mb-[0.55rem] font-sans text-[0.72rem] tracking-[0.14em] text-ink-faint uppercase">
          {t.works.filterLanguage}
        </legend>
        <div class="flex flex-wrap gap-[0.35rem]">
          <button type="button" class:list={[chipClass, 'chip chip--on']} data-filter="language" data-value="all">
            {t.works.filterAll}
          </button>
          {SOURCE_LANGUAGES.map((code) => (
            <button type="button" class:list={[chipClass, 'chip']} data-filter="language" data-value={code}>
              {t.languages[code]}
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset class="min-w-0">
        <legend class="mb-[0.55rem] font-sans text-[0.72rem] tracking-[0.14em] text-ink-faint uppercase">
          {t.works.filterCategory}
        </legend>
        <div class="flex flex-wrap gap-[0.35rem]">
          <button type="button" class:list={[chipClass, 'chip chip--on']} data-filter="category" data-value="all">
            {t.works.filterAll}
          </button>
          {CATEGORIES.map((code) => (
            <button type="button" class:list={[chipClass, 'chip']} data-filter="category" data-value={code}>
              {t.categories[code]}
            </button>
          ))}
        </div>
      </fieldset>
    </div>
  )
}

<ul
  class="m-0 mb-12 grid grid-cols-[repeat(auto-fill,minmax(min(100%,11rem),1fr))] gap-x-[clamp(1.25rem,3vw,2.25rem)] gap-y-[clamp(1.5rem,4vw,3rem)]"
  data-catalogue
>
  {
    ALL_BOOKS.map((book, index) => (
      <li
        class="card"
        data-language={book.originalLanguage}
        data-category={book.category}
        data-reveal
        style={`--tint:${paletteFor(book.id).spineColor};--reveal-delay:${Math.min(index, 5) * 40}ms;`}
      >
        <a class="group grid h-full gap-[0.9rem] no-underline" href={bookPath(locale, book.id)}>
          <span class="block [perspective:900px]">
            {/* Paired with the record page's cover and heading by name, so the
                browser lifts this one volume out of the grid on the way there
                instead of repainting the page. Costs no JavaScript: the
                navigation is an ordinary one, and `@view-transition` in
                view-transitions.css is what makes the browser animate across it. */}
            <img
              class="[view-transition-class:vt-cover] aspect-[2/3] w-full rounded-[2px] object-cover shadow-md transition-[transform,box-shadow] duration-[320ms] ease-out group-hover:-translate-y-[6px] group-hover:rotate-x-[3deg] group-hover:scale-[1.012] group-hover:shadow-[0_8px_18px_rgb(30_26_22/0.13),0_26px_56px_color-mix(in_srgb,var(--tint)_34%,transparent)] group-focus-visible:-translate-y-[6px] group-focus-visible:rotate-x-[3deg] group-focus-visible:scale-[1.012] group-focus-visible:shadow-[0_8px_18px_rgb(30_26_22/0.13),0_26px_56px_color-mix(in_srgb,var(--tint)_34%,transparent)]"
              src={thumbFor(book.id)}
              width="320"
              height="480"
              loading={index < 4 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
              alt={interpolate(t.book.coverAlt, { title: book.title, author: book.author })}
              style={`view-transition-name:cover-${book.id}`}
            />
          </span>
          <span class="grid content-start gap-[0.1rem]">
            {/* Catalogue numbers run over the whole bibliography, not over
                whatever the filters have left standing — they are the volume's
                number, not its position in the current view. */}
            <span class="mb-[0.45rem] flex items-baseline justify-between gap-[0.5rem] border-b border-rule pb-[0.4rem] font-sans text-[0.66rem] tracking-[0.14em] text-ink-faint tabular-nums transition-colors duration-[240ms] ease-brand group-hover:border-b-[var(--tint)]">
              <span class="text-ink">{String(index + 1).padStart(2, '0')}</span>
              <span>{book.year}</span>
            </span>
            <span
              class="[view-transition-class:vt-title] text-[1rem] leading-[1.3] font-semibold"
              style={`view-transition-name:title-${book.id}`}
            >
              {book.title}
            </span>
            <span class="font-sans text-[0.78rem] text-ink-soft">{book.author}</span>
            <span class="mt-[0.2rem] font-sans text-[0.7rem] text-ink-faint">{book.publisher}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<p class="font-sans py-8 text-ink-faint" data-empty hidden>{t.works.empty}</p>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  const list = document.querySelector<HTMLElement>('[data-catalogue]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (root && list && empty) {
    const state: Record<string, string> = { language: 'all', category: 'all' };

    const apply = () => {
      let visible = 0;
      for (const card of list.querySelectorAll<HTMLElement>('.card')) {
        const matches =
          (state.language === 'all' || card.dataset.language === state.language) &&
          (state.category === 'all' || card.dataset.category === state.category);
        card.hidden = !matches;
        if (matches) visible += 1;
      }
      empty.hidden = visible > 0;
    };

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;
      const group = button.dataset.filter!;
      state[group] = button.dataset.value!;
      for (const sibling of root.querySelectorAll<HTMLElement>(`[data-filter="${group}"]`)) {
        sibling.classList.toggle('chip--on', sibling === button);
        sibling.setAttribute('aria-pressed', String(sibling === button));
      }
      apply();
    });

    for (const button of root.querySelectorAll<HTMLElement>('[data-filter]')) {
      button.setAttribute('aria-pressed', String(button.classList.contains('chip--on')));
    }
  }
</script>
