---
import { type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { PROFILE, bioFor } from '~/data/profile';
import { ALL_BOOKS } from '~/data/books';
import { assetPath } from '~/i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const paragraphs = bioFor(locale);
const years = ALL_BOOKS.map((book) => book.year);
const span = years.length > 0 ? `${Math.min(...years)}–${Math.max(...years)}` : null;

// The site's one drop cap: the opening letter of the first paragraph only.
const firstLetterClass =
  'first:first-letter:float-left first:first-letter:pt-[0.08em] first:first-letter:pr-[0.1em] first:first-letter:text-[3.1em] first:first-letter:leading-[0.82] first:first-letter:text-accent';
---

<div class="page-head">
  <p class="eyebrow">{PROFILE.location[locale]}</p>
  <h1>{t.about.title}</h1>
  <p class="lead">{t.about.lead}</p>
</div>

<div class="grid items-start gap-[clamp(2rem,5vw,4rem)] lg:grid-cols-[minmax(0,1.6fr)_minmax(15rem,0.8fr)]" data-reveal>
  <div>
    {paragraphs.map((paragraph) => <p class:list={['text-[1.06em]', firstLetterClass]}>{paragraph}</p>)}

    {
      PROFILE.publications.length > 0 && (
        <section class="mt-[clamp(2.5rem,6vw,4rem)] border-t border-rule pt-6">
          <h2 class="mb-6 font-sans text-[0.68rem] font-semibold tracking-[0.14em] text-ink-faint uppercase">
            {t.about.research}
          </h2>
          <ol class="grid gap-[1.35rem]">
            {PROFILE.publications.map((entry) => (
              <li class="grid grid-cols-[3.2rem_minmax(0,1fr)] items-baseline gap-x-3 border-t border-rule pt-[1.35rem] first:border-t-0 first:pt-0 max-[30rem]:grid-cols-1 max-[30rem]:gap-[0.2rem]">
                <span class="font-sans text-[0.75rem] text-ink-faint tabular-nums">{entry.year}</span>
                <span class="grid min-w-0 gap-[0.15rem]">
                  <cite class="text-[0.98rem] leading-[1.4] not-italic">
                    {entry.href ? (
                      <a href={entry.href} rel="noopener" target="_blank">
                        {entry.title}
                      </a>
                    ) : (
                      entry.title
                    )}
                  </cite>
                  <span class="font-sans text-[0.78rem] leading-[1.5] text-ink-faint italic">{entry.venue}</span>
                  {entry.with && (
                    <span class="font-sans text-[0.78rem] leading-[1.5] text-ink-faint">
                      {t.book.coTranslators} {entry.with.join(', ')}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>

  <aside class="grid gap-8 pt-[0.4rem]">
    {
      PROFILE.portrait && (
        <img
          class="aspect-[4/5] w-full rounded-[2px] object-cover shadow-md"
          src={assetPath(PROFILE.portrait.src)}
          width={PROFILE.portrait.width}
          height={PROFILE.portrait.height}
          alt={t.about.portraitAlt}
        />
      )
    }

    {
      span && (
        <div class="grid border-b border-rule pb-5">
          <span class="font-sans text-[0.72rem] tracking-[0.14em] text-ink-faint uppercase">{t.works.title}</span>
          <span class="text-[2.4rem] leading-[1.1] font-semibold">{ALL_BOOKS.length}</span>
          <span class="font-sans text-[0.78rem] text-ink-faint">{span}</span>
        </div>
      )
    }

    {
      PROFILE.timeline.length > 0 && (
        <ol class="grid gap-[1.4rem]">
          {PROFILE.timeline.map((entry) => (
            <li class="grid gap-[0.1rem] border-s-2 border-rule ps-4">
              <span class="font-sans text-[0.72rem] tracking-[0.12em] text-ink-faint">{entry.period}</span>
              <span class="leading-[1.3] font-semibold">
                {entry.href ? (
                  <a href={entry.href} rel="noopener">
                    {entry.title[locale]}
                  </a>
                ) : (
                  entry.title[locale]
                )}
              </span>
              <span class="font-sans text-[0.82rem] leading-[1.5] text-ink-soft">{entry.detail[locale]}</span>
            </li>
          ))}
        </ol>
      )
    }
  </aside>
</div>
