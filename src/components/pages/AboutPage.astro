---
import { type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { PROFILE, bioFor } from '~/data/profile';
import { ALL_BOOKS } from '~/data/books';
import { assetPath } from '~/i18n/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const paragraphs = bioFor(locale);
const years = ALL_BOOKS.map((book) => book.year);
const span = years.length > 0 ? `${Math.min(...years)}–${Math.max(...years)}` : null;
---

<div class="page-head">
  <p class="eyebrow">{PROFILE.location[locale]}</p>
  <h1>{t.about.title}</h1>
  <p class="lead">{t.about.lead}</p>
</div>

<div class="about">
  <div class="about__prose">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}

    {
      PROFILE.publications.length > 0 && (
        <section class="research">
          <h2>{t.about.research}</h2>
          <ol>
            {PROFILE.publications.map((entry) => (
              <li>
                <span class="research__year">{entry.year}</span>
                <span class="research__body">
                  <cite>
                    {entry.href ? (
                      <a href={entry.href} rel="noopener" target="_blank">
                        {entry.title}
                      </a>
                    ) : (
                      entry.title
                    )}
                  </cite>
                  <span class="research__venue">{entry.venue}</span>
                  {entry.with && (
                    <span class="research__with">{t.book.coTranslators} {entry.with.join(', ')}</span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>

  <aside class="about__side">
    {
      PROFILE.portrait && (
        <img
          class="portrait"
          src={assetPath(PROFILE.portrait.src)}
          width={PROFILE.portrait.width}
          height={PROFILE.portrait.height}
          alt={t.about.portraitAlt}
        />
      )
    }

    {
      span && (
        <div class="fact">
          <span class="fact__label">{t.works.title}</span>
          <span class="fact__value">{ALL_BOOKS.length}</span>
          <span class="fact__note">{span}</span>
        </div>
      )
    }

    {
      PROFILE.timeline.length > 0 && (
        <ol class="timeline">
          {PROFILE.timeline.map((entry) => (
            <li>
              <span class="timeline__period">{entry.period}</span>
              <span class="timeline__title">
                {entry.href ? (
                  <a href={entry.href} rel="noopener">
                    {entry.title[locale]}
                  </a>
                ) : (
                  entry.title[locale]
                )}
              </span>
              <span class="timeline__detail">{entry.detail[locale]}</span>
            </li>
          ))}
        </ol>
      )
    }
  </aside>
</div>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 0.8fr);
    }
  }

  .about__prose p {
    font-size: 1.06em;
  }

  .about__prose p:first-child::first-letter {
    float: left;
    font-size: 3.1em;
    line-height: 0.82;
    padding: 0.08em 0.1em 0 0;
    color: var(--accent);
  }

  .about__side {
    display: grid;
    gap: 2rem;
    padding-top: 0.4rem;
  }

  .portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: var(--shadow-md);
  }

  /* --- research ---------------------------------------------------------- */

  .research {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .research h2 {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 1.5rem;
  }

  .research ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.35rem;
  }

  .research li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 0 0.75rem;
    align-items: baseline;
  }

  .research__year {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  .research__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .research cite {
    font-style: normal;
    font-size: 0.98rem;
    line-height: 1.4;
  }

  .research__venue,
  .research__with {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-faint);
    line-height: 1.5;
  }

  .research__venue {
    font-style: italic;
  }

  @media (max-width: 30rem) {
    .research li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }

  .fact {
    display: grid;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .fact__label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .fact__value {
    font-size: 2.4rem;
    line-height: 1.1;
    font-weight: 600;
  }

  .fact__note {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
  }

  .timeline li {
    display: grid;
    gap: 0.1rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--rule);
  }

  .timeline__period {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .timeline__title {
    font-weight: 600;
    line-height: 1.3;
  }

  .timeline__detail {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
</style>
