---
import { type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { PROFILE, bioFor } from '~/data/profile';
import { ALL_BOOKS } from '~/data/books';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const paragraphs = bioFor(locale);
const years = ALL_BOOKS.map((book) => book.year);
const span = years.length > 0 ? `${Math.min(...years)}–${Math.max(...years)}` : null;
---

<div class="page-head">
  <p class="eyebrow">{PROFILE.location[locale]}</p>
  <h1>{t.about.title}</h1>
  <p class="lead">{t.about.lead}</p>
</div>

<div class="about">
  <div class="about__prose">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <aside class="about__side">
    {
      span && (
        <div class="fact">
          <span class="fact__label">{t.works.title}</span>
          <span class="fact__value">{ALL_BOOKS.length}</span>
          <span class="fact__note">{span}</span>
        </div>
      )
    }

    {
      PROFILE.timeline.length > 0 && (
        <ol class="timeline">
          {PROFILE.timeline.map((entry) => (
            <li>
              <span class="timeline__period">{entry.period}</span>
              <span class="timeline__title">
                {entry.href ? (
                  <a href={entry.href} rel="noopener">
                    {entry.title[locale]}
                  </a>
                ) : (
                  entry.title[locale]
                )}
              </span>
              <span class="timeline__detail">{entry.detail[locale]}</span>
            </li>
          ))}
        </ol>
      )
    }
  </aside>
</div>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 0.8fr);
    }
  }

  .about__prose p {
    font-size: 1.06em;
  }

  .about__prose p:first-child::first-letter {
    float: left;
    font-size: 3.1em;
    line-height: 0.82;
    padding: 0.08em 0.1em 0 0;
    color: var(--accent);
  }

  .about__side {
    display: grid;
    gap: 2rem;
    padding-top: 0.4rem;
  }

  .fact {
    display: grid;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .fact__label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .fact__value {
    font-size: 2.4rem;
    line-height: 1.1;
    font-weight: 600;
  }

  .fact__note {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
  }

  .timeline li {
    display: grid;
    gap: 0.1rem;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--rule);
  }

  .timeline__period {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
  }

  .timeline__title {
    font-weight: 600;
    line-height: 1.3;
  }

  .timeline__detail {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
</style>
