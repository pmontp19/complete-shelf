---
import { type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { PROFILE } from '~/data/profile';
import { faqEntries } from '~/data/faq';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// The same six answers the page's `FAQPage` markup carries.
const faq = faqEntries(locale);

const labelClass = 'block font-sans text-[0.72rem] tracking-[0.14em] text-ink-faint uppercase mb-[0.35rem]';
const blockClass = 'border-t border-rule pt-[1.35rem]';
---

<div class="page-head">
  <p class="eyebrow">{t.site.role}</p>
  <h1>{t.contact.title}</h1>
  <p class="lead">{t.contact.lead}</p>
</div>

<div class="grid gap-9 pt-4 pb-12" data-reveal>
  {
    PROFILE.email && (
      <p class={`m-0 max-w-none ${blockClass}`}>
        <span class={labelClass}>{t.contact.email}</span>
        <a
          class="text-[clamp(1.2rem,1rem+1.1vw,1.75rem)] decoration-[color-mix(in_srgb,var(--color-accent)_50%,transparent)]"
          href={`mailto:${PROFILE.email}`}
        >
          {PROFILE.email}
        </a>
      </p>
    )
  }

  <div class={blockClass}>
    <p class={labelClass}>{t.contact.languages}</p>
    <p class="m-0 text-[1.05rem]">{PROFILE.workingLanguages[locale]}</p>
  </div>

  {
    PROFILE.fields[locale].length > 0 && (
      <div class={blockClass}>
        <p class={labelClass}>{t.contact.fields}</p>
        <ul class="grid max-w-[46ch] gap-[0.55rem]">
          {PROFILE.fields[locale].map((field) => (
            <li class="border-s-2 border-rule ps-4 leading-[1.45]">{field}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    PROFILE.links.length > 0 && (
      <div class={blockClass}>
        <p class={labelClass}>{t.contact.elsewhere}</p>
        <ul class="grid gap-[0.5rem]">
          {PROFILE.links.map((link) => (
            <li>
              <a
                class="inline-flex items-baseline gap-[0.5rem] font-sans text-[0.95rem]"
                href={link.href}
                rel="me noopener"
                target="_blank"
              >
                {link.label}
                {link.handle && <span class="text-[0.8rem] text-ink-faint">{link.handle}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    faq.length > 0 && (
      <section class={blockClass}>
        <h2 class={`${labelClass} mb-[0.9rem] text-[0.72rem] font-medium`}>{t.faq.title}</h2>
        <dl class="m-0 grid max-w-[62ch] gap-6">
          {faq.map((entry) => (
            <div>
              <dt class="text-[1.02rem] leading-[1.35] font-semibold">{entry.question}</dt>
              <dd class="mt-[0.4rem] leading-[1.65] text-ink-soft">{entry.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</div>
