---
import { type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';
import { PROFILE } from '~/data/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="page-head">
  <p class="eyebrow">{t.site.role}</p>
  <h1>{t.contact.title}</h1>
  <p class="lead">{t.contact.lead}</p>
</div>

<div class="contact">
  {
    PROFILE.email && (
      <p class="contact__primary">
        <span class="contact__label">{t.contact.email}</span>
        <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
      </p>
    )
  }

  <div class="contact__block">
    <p class="contact__label">{t.contact.languages}</p>
    <p class="contact__pair">{PROFILE.workingLanguages[locale]}</p>
  </div>

  {
    PROFILE.fields[locale].length > 0 && (
      <div class="contact__block">
        <p class="contact__label">{t.contact.fields}</p>
        <ul class="fields">
          {PROFILE.fields[locale].map((field) => (
            <li>{field}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    PROFILE.links.length > 0 && (
      <div class="contact__links">
        <p class="contact__label">{t.contact.elsewhere}</p>
        <ul>
          {PROFILE.links.map((link) => (
            <li>
              <a href={link.href} rel="me noopener" target="_blank">
                {link.label}
                {link.handle && <span class="handle">{link.handle}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .contact {
    display: grid;
    gap: 2.5rem;
    padding-block: 1rem 3rem;
  }

  .contact__label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.35rem;
  }

  .contact__primary a {
    font-size: clamp(1.2rem, 1rem + 1.1vw, 1.75rem);
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .contact__pair {
    margin: 0;
    font-size: 1.05rem;
  }

  .fields {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
    max-width: 46ch;
  }

  .fields li {
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--rule);
    line-height: 1.45;
  }

  .contact__links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .contact__links a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  .handle {
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
</style>
