---
import { type Locale } from '~/i18n/config';
import { useTranslations, interpolate } from '~/i18n/ui';
import { ALL_BOOKS, toShelfBooks, paletteFor, thumbFor } from '~/data/books';
import { bookPath } from '~/i18n/paths';
import type { ShelfLabels } from '~/lib/shelf/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const shelfBooks = toShelfBooks(locale, { languages: t.languages });

/** Everything the caption needs, so the panel is one node the shelf rewrites. */
const captions = ALL_BOOKS.map((book) => ({
  id: book.id,
  title: book.title,
  originalTitle: book.originalTitle,
  author: book.author,
  imprint: `${book.publisher} · ${book.year}`,
  pair: `${t.languages[book.originalLanguage]} → ${t.languages[book.targetLanguage]}`,
  href: bookPath(locale, book.id),
  palette: paletteFor(book.id),
}));

const first = captions[0];
const total = captions.length;

// Typed against the engine's own contract (not just this object's inferred
// shape), so a locale missing a key `ShelfLabels` requires is a build error
// here rather than an `undefined` the client-side `JSON.parse` cast below
// would otherwise wave through silently.
const labels: ShelfLabels = {
  region: t.shelf.region,
  previous: t.shelf.previous,
  next: t.shelf.next,
  open: t.shelf.open,
  selected: t.shelf.selected,
  loading: t.shelf.loading,
  webglUnsupported: t.shelf.webglUnsupported,
  inspect: t.shelf.inspect,
  exitInspect: t.shelf.exitInspect,
  orbitHint: t.shelf.orbitHint,
  zoomHint: t.shelf.zoomHint,
  resetView: t.shelf.resetView,
};

const payload = {
  books: shelfBooks,
  captions,
  labels,
};

const pad = (value: number) => String(value).padStart(2, '0');

// The 3D shelf and the static grid are mutually exclusive; both toggle off
// `data-ready`/`data-mounted` set on the root once shelf.ts takes over.
const stepperClass =
  'grid size-9 flex-none place-content-center rounded-full border border-rule bg-transparent p-0 text-ink-soft transition-colors duration-[180ms] ease-brand hover:border-ink-faint hover:bg-paper-raised hover:text-ink active:bg-paper-sunk';
---

<section class="group block" data-shelf-root data-mode="browse">
  {/* Marks the run as script-capable before anything paints, so a reader who
      will get the 3D shelf never sees the static grid flash up first and then
      get replaced. Without this the grid is visible for however long the engine
      takes to mount, which is a full frame of the wrong page on every load.
      Inline and un-deferred on purpose: it has to run during parsing, before
      the fallback below is painted. `data-js` only claims that JavaScript ran,
      not that the shelf works: the mount's own failure path clears it again, so
      a browser without WebGL still falls back to the grid. */}
  <script is:inline>
    document.currentScript.parentElement.dataset.js = 'true';
  </script>
  <div
    class="shelf__stage relative hidden h-[min(clamp(24rem,62vh,42rem),70vh)] overflow-hidden bg-[radial-gradient(120%_76%_at_50%_92%,color-mix(in_srgb,var(--tint)_22%,transparent),transparent_66%),linear-gradient(180deg,var(--color-paper)_8%,color-mix(in_srgb,var(--tint)_7%,var(--color-paper))_58%,var(--color-paper)_100%)] transition-[background] duration-700 ease-brand group-data-[js=true]:block group-data-[mounted=true]:block max-md:h-[min(clamp(20rem,52vh,28rem),70vh)]"
  >
    <div
      class="absolute inset-0 opacity-0 transition-opacity duration-900 ease-brand group-data-[ready=true]:opacity-100"
      data-shelf-canvas
    >
    </div>
    <p
      class="absolute inset-0 grid place-content-center font-sans text-[0.78rem] tracking-[0.14em] text-ink-faint uppercase"
      data-shelf-loading
    >
      {t.shelf.loading}
    </p>

    {/* Inspect-mode chrome: state lives entirely on [data-shelf-root]'s
        data-mode, written by the engine's onMode callback below. These two
        nodes are `inert` in the markup (safe by default, before any script
        runs) and the inline script only ever flips that attribute in step
        with the mode, so neither is a keyboard or pointer target while
        browsing. global.css drives the fade purely off data-mode, on
        transform/opacity only, so none of this touches the stage's box. */}
    <button
      type="button"
      data-shelf-inspect-exit
      inert
      aria-label={t.shelf.exitInspect}
      class="absolute top-[clamp(0.75rem,3vw,1.5rem)] right-[clamp(0.75rem,3vw,1.5rem)] z-10 grid size-9 flex-none place-content-center rounded-full border border-rule bg-paper/85 text-ink-soft backdrop-blur-sm hover:border-ink-faint hover:bg-paper-raised hover:text-ink active:bg-paper-sunk"
    >
      <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </svg>
    </button>

    <div
      data-shelf-inspect-hints
      inert
      class="pointer-events-none absolute inset-x-0 bottom-[clamp(0.75rem,3vw,1.5rem)] z-10 flex flex-wrap items-center justify-center gap-x-[clamp(1rem,3vw,2rem)] gap-y-1 px-4 text-center font-sans text-[0.68rem] tracking-[0.1em] text-ink-faint uppercase"
    >
      <span>{t.shelf.orbitHint}</span>
      <span class="opacity-50" aria-hidden="true">·</span>
      <span>{t.shelf.zoomHint}</span>
    </div>
  </div>

  {/* The instrument panel: a hairline rule carrying the position of the
      carriage, its two controls, and the running count. */}
  <div
    class="shell hidden items-center gap-[clamp(0.75rem,2vw,1.5rem)] border-y border-rule py-[0.85rem] group-data-[mounted=true]:flex"
    data-shelf-controls
  >
    <button class={stepperClass} type="button" data-shelf-prev aria-label={t.shelf.previous}>
      <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>

    <div class="relative h-px flex-1 bg-rule" aria-hidden="true">
      <span
        class="absolute top-1/2 left-[calc(var(--at,0)*100%)] h-0.5 w-[clamp(2.5rem,8%,5rem)] -mt-px origin-left bg-[var(--tint,var(--color-accent))] transition-[left] duration-[120ms] ease-linear"
        data-shelf-thumb
      ></span>
    </div>

    <p class="m-0 flex flex-none items-center gap-[0.45rem] font-sans text-[0.72rem] tracking-[0.12em] text-ink-faint tabular-nums" aria-hidden="true">
      <span class="text-ink" data-shelf-position>{pad(1)}</span>
      <span class="h-px w-[0.85rem] bg-current opacity-60"></span>
      <span>{pad(total)}</span>
    </p>

    <button class={stepperClass} type="button" data-shelf-next aria-label={t.shelf.next}>
      <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </button>
  </div>

  {/* Museum label. One node, rewritten as the carriage moves — the shelf's own
      live region does the announcing, so this stays visual. */}
  {
    first && (
      <div class="shell">
        <article
          class="grid hidden gap-[clamp(1.25rem,3vw,2.5rem)] py-[clamp(1.5rem,3.5vw,2.25rem)] group-data-[mounted=true]:grid min-[56rem]:grid-cols-[minmax(0,1.15fr)_minmax(0,1.35fr)_auto]"
          data-shelf-caption
          style={`--tint:${first.palette.spineColor};--tint-contrast:${first.palette.textColor};`}
        >
          <div class="min-w-0">
            <p class="eyebrow">{t.home.selectedHeading}</p>
            <h2 class="mb-[0.12em] text-[clamp(1.5rem,1.1rem+1.5vw,2.35rem)] text-balance" data-caption-title>
              {first.title}
            </h2>
            <p class="m-0 font-sans text-[0.85rem] tracking-[0.03em] text-ink-faint" data-caption-author>
              {first.author}
            </p>
          </div>

          <dl class="m-0 grid content-start gap-[0.85rem_2rem] min-[34rem]:grid-cols-[repeat(auto-fit,minmax(min(100%,10rem),1fr))]">
            <div>
              <dt class="mb-[0.2rem] font-sans text-[0.68rem] tracking-[0.14em] text-ink-faint uppercase">
                {t.book.originalTitle}
              </dt>
              <dd class="m-0 text-[0.95rem] leading-[1.45]">
                <i data-caption-original>{first.originalTitle}</i>
              </dd>
            </div>
            <div>
              <dt class="mb-[0.2rem] font-sans text-[0.68rem] tracking-[0.14em] text-ink-faint uppercase">
                {t.book.publisher}
              </dt>
              <dd class="m-0 text-[0.95rem] leading-[1.45]" data-caption-imprint>{first.imprint}</dd>
            </div>
            <div>
              <dt class="mb-[0.2rem] font-sans text-[0.68rem] tracking-[0.14em] text-ink-faint uppercase">
                {t.book.from}
              </dt>
              <dd class="m-0 text-[0.95rem] leading-[1.45]" data-caption-pair>{first.pair}</dd>
            </div>
          </dl>

          <p class="m-0">
            <a
              class="button"
              href={first.href}
              data-caption-href
              style="--button-bg:var(--tint);--button-fg:var(--tint-contrast)"
            >
              {t.shelf.open}
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="button__arrow">
                <path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </a>
          </p>
        </article>
      </div>
    )
  }

  {/* Progressive enhancement: this list is the page until (and unless) the
      WebGL shelf mounts successfully. Hidden on `data-js` as well as on
      `data-mounted`, so it never flashes for a reader who is about to get the
      shelf; the mount's failure path clears `data-js` and brings it straight
      back. Without JavaScript neither attribute is ever set and this simply is
      the page, which is the whole point of it. */}
  <div
    class="shell py-[clamp(1.5rem,4vw,2.5rem)] group-data-[js=true]:hidden group-data-[mounted=true]:hidden"
    data-shelf-fallback
  >
    <h2 class="visually-hidden">{t.shelf.listFallback}</h2>
    <ul class="fallback-grid grid grid-cols-[repeat(auto-fill,minmax(9.5rem,1fr))] gap-[clamp(1.25rem,3vw,2.25rem)]">
      {
        ALL_BOOKS.map((book) => (
          <li>
            <a class="group grid gap-[0.15rem] no-underline" href={bookPath(locale, book.id)}>
              <img
                class="mb-[0.6rem] aspect-[2/3] w-full rounded-[2px] object-cover shadow-md transition-transform duration-[220ms] ease-brand group-hover:-translate-y-[3px]"
                src={thumbFor(book.id)}
                width="320"
                height="480"
                loading="lazy"
                decoding="async"
                alt={interpolate(t.book.coverAlt, { title: book.title, author: book.author })}
              />
              <span class="text-[0.95rem] leading-[1.3] font-semibold">{book.title}</span>
              <span class="font-sans text-[0.75rem] text-ink-faint">{book.author}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <script is:inline type="application/json" data-shelf-payload set:html={JSON.stringify(payload)}
  ></script>
</section>

<script>
  import { mountShelf } from '~/lib/shelf/shelf';
  import type { ShelfMode, ShelfOptions } from '~/lib/shelf/types';

  interface Caption {
    id: string;
    title: string;
    originalTitle: string;
    author: string;
    imprint: string;
    pair: string;
    href: string;
    palette: { spineColor: string; textColor: string };
  }

  const root = document.querySelector<HTMLElement>('[data-shelf-root]');
  const canvas = root?.querySelector<HTMLElement>('[data-shelf-canvas]');
  const payloadEl = root?.querySelector<HTMLScriptElement>('[data-shelf-payload]');

  if (root && canvas && payloadEl?.textContent) {
    const payload = JSON.parse(payloadEl.textContent) as Pick<ShelfOptions, 'books' | 'labels'> & {
      captions: Caption[];
    };

    const pick = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector);
    const caption = pick<HTMLElement>('[data-shelf-caption]');
    const titleEl = pick<HTMLElement>('[data-caption-title]');
    const authorEl = pick<HTMLElement>('[data-caption-author]');
    const originalEl = pick<HTMLElement>('[data-caption-original]');
    const imprintEl = pick<HTMLElement>('[data-caption-imprint]');
    const pairEl = pick<HTMLElement>('[data-caption-pair]');
    const linkEl = pick<HTMLAnchorElement>('[data-caption-href]');
    const positionEl = pick<HTMLElement>('[data-shelf-position]');
    const thumbEl = pick<HTMLElement>('[data-shelf-thumb]');
    const loadingEl = pick<HTMLElement>('[data-shelf-loading]');
    const previousButton = pick<HTMLButtonElement>('[data-shelf-prev]');
    const nextButton = pick<HTMLButtonElement>('[data-shelf-next]');
    const exitButton = pick<HTMLButtonElement>('[data-shelf-inspect-exit]');
    const hintsEl = pick<HTMLElement>('[data-shelf-inspect-hints]');
    const controlsEl = pick<HTMLElement>('[data-shelf-controls]');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pad = (value: number) => String(value).padStart(2, '0');

    // The engine is the only thing allowed to decide the mode; this just
    // mirrors it onto the DOM as `data-mode` (global.css does the fading) and
    // keeps the inspect-only and browse-only chrome out of the tab order
    // and off the accessibility tree while it does not apply. `focusing` is
    // grouped with `inspect` (and `returning` with `browse`) so the chrome
    // starts moving in step with the camera instead of snapping in only
    // once it has already arrived.
    const applyMode = (mode: ShelfMode) => {
      const inspecting = mode === 'focusing' || mode === 'inspect';

      // `inert` blurs a focused descendant to <body> the instant its
      // ancestor gains the attribute, so the only reliable moment to ask
      // "does the control about to go inert hold focus" is before that
      // toggle runs. `.contains()`, not an identity check, because the
      // hints block and the controls bar are containers with focusable
      // descendants rather than focusable themselves.
      const focusLeavesControls = inspecting && !!controlsEl?.contains(document.activeElement);
      const focusLeavesInspectChrome =
        !inspecting &&
        (!!exitButton?.contains(document.activeElement) || !!hintsEl?.contains(document.activeElement));

      root.dataset.mode = mode;
      exitButton?.toggleAttribute('inert', !inspecting);
      hintsEl?.toggleAttribute('inert', !inspecting);
      controlsEl?.toggleAttribute('inert', inspecting);

      // Only move focus when it would otherwise be stranded on <body>: an
      // unrequested focus jump is a bug of its own. `preventScroll` matches
      // the rule that entering or leaving inspect must never touch scroll
      // position. The engine's own focusable region (guarded, since the
      // fallback path never creates one) is where a reader who just left
      // inspect can carry on browsing with the arrow keys.
      if (focusLeavesControls) {
        exitButton?.focus({ preventScroll: true });
      } else if (focusLeavesInspectChrome) {
        root.querySelector<HTMLElement>('.shelf3d-region')?.focus({ preventScroll: true });
      }
    };

    let shown = -1;
    const showCaption = (index: number) => {
      const entry = payload.captions[index];
      if (!entry || index === shown) return;
      const first = shown === -1;
      shown = index;

      if (titleEl) titleEl.textContent = entry.title;
      if (authorEl) authorEl.textContent = entry.author;
      if (originalEl) originalEl.textContent = entry.originalTitle;
      if (imprintEl) imprintEl.textContent = entry.imprint;
      if (pairEl) pairEl.textContent = entry.pair;
      if (linkEl) linkEl.href = entry.href;
      if (positionEl) positionEl.textContent = pad(index + 1);
      caption?.style.setProperty('--tint', entry.palette.spineColor);
      caption?.style.setProperty('--tint-contrast', entry.palette.textColor);
      root.style.setProperty('--tint', entry.palette.spineColor);

      // A label being replaced, not a page repainting: the new text rises into
      // place. Skipped on first paint (nothing changed yet) and when the
      // reader has asked for less movement.
      if (caption && !first && !reduced.matches) {
        caption.getAnimations().forEach((animation) => animation.cancel());
        caption.animate(
          [
            { opacity: 0, transform: 'translateY(8px)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: 420, easing: 'cubic-bezier(0.22, 0.61, 0.36, 1)' },
        );
      }
    };

    mountShelf(canvas, {
      books: payload.books,
      labels: payload.labels,
      onSelect(_book, index) {
        showCaption(index);
      },
      onProgress(position, total) {
        if (!thumbEl || total === 0) return;
        // The run loops, so the thumb loops with it: position on the rail is
        // where the carriage sits within one pass of the collection.
        const laps = ((position % total) + total) % total;
        thumbEl.style.setProperty('--at', String(laps / total));
      },
      onReady() {
        root.dataset.ready = 'true';
      },
      onActivate(book) {
        window.location.href = book.href;
      },
      onMode(mode) {
        applyMode(mode);
      },
    })
      .then((shelf) => {
        root.dataset.mounted = 'true';
        loadingEl?.remove();
        previousButton?.addEventListener('click', () => shelf.previous());
        nextButton?.addEventListener('click', () => shelf.next());
        exitButton?.addEventListener('click', () => shelf.returnToShelf());
      })
      .catch((error) => {
        // Leave the HTML fallback in place; it is a complete experience. The
        // inline script above hid it on `data-js` to stop it flashing during a
        // normal load, so clearing that is what brings it back for a reader
        // whose shelf never mounted, along with the empty stage that would
        // otherwise sit above it.
        console.error('[shelf] mount failed, keeping the static catalogue', error);
        delete root.dataset.js;
        loadingEl?.remove();
      });
  }
</script>
