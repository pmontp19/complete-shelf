---
import { LOCALES, LOCALE_NAMES, LOCALE_TAGS, HREFLANGS, type Locale } from '~/i18n/config';
import { translatePath } from '~/i18n/paths';
import { useTranslations } from '~/i18n/ui';
import type { PageRef } from '~/i18n/page-ref';

interface Props {
  locale: Locale;
  page: PageRef;
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);

// Short codes keep the switcher compact on phones; the full name stays in the
// accessible name so screen readers announce something meaningful.
const SHORT: Record<Locale, string> = { ca: 'CA', es: 'ES', en: 'EN', de: 'DE', fr: 'FR' };
---

<nav class="langs" aria-label={t.a11y.languageSwitcher}>
  <ul class="flex items-center gap-[0.15rem]">
    {
      LOCALES.map((code) => {
        const isCurrent = code === locale;
        return (
          <li>
            <a
              href={translatePath(code, page)}
              hreflang={HREFLANGS[code]}
              lang={LOCALE_TAGS[code]}
              aria-current={isCurrent ? 'page' : undefined}
              aria-label={isCurrent ? `${t.a11y.currentLanguage}: ${LOCALE_NAMES[code]}` : LOCALE_NAMES[code]}
              class:list={[
                'block rounded px-[0.45rem] py-[0.3rem] font-sans text-[0.72rem] font-medium tracking-[0.08em] text-ink-faint no-underline transition-colors duration-[160ms] ease-brand hover:bg-paper-sunk hover:text-ink',
                { 'bg-paper-sunk font-[650] text-ink': isCurrent },
              ]}
            >
              <span aria-hidden="true">{SHORT[code]}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
