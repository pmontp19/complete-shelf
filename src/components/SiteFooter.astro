---
import type { Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer__inner">
    <p class="footer__line">© {year} {t.site.name}. {t.footer.rights}</p>
    <p class="footer__note">{t.footer.coverNotice}</p>
    <p class="footer__note footer__colophon">{t.footer.colophon}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--rule);
    background: var(--paper-sunk);
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
  }

  .footer__inner {
    display: grid;
    gap: 0.4rem;
  }

  .footer__line,
  .footer__note {
    margin: 0;
    font-family: var(--font-sans);
    max-width: 68ch;
  }

  .footer__line {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .footer__note {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .footer__colophon {
    margin-top: 0.35rem;
  }
</style>
